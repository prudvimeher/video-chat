# Copy this file to .env for local backend development. Do not commit .env.
# Use deployment-provider secrets for Render/Fly rather than putting values in
# render.yaml or fly.toml.
TURN_USERNAME=your_openrelay_username
TURN_CREDENTIAL=your_openrelay_credential
# Exact Vercel frontend URL; no trailing slash.
FRONTEND_ORIGIN=https://your-app.vercel.app
